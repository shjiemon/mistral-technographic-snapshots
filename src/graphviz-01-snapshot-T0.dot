digraph Mistral_T0 {
    // ========================================
    // GRAPH SETTINGS — consistent with original DOT files
    // ========================================
    graph [label="T₀ — Mistral AI Infrastructure Ecosystem (September 2023)", labelloc=t, fontsize=19, fontname="Bitter", rankdir=TB, bgcolor="white", nodesep=0.55, ranksep=0.55, splines=polyline, pad=0.35, outputorder=edgesfirst, newrank=true];
    node [fontname="Bitter", fontsize=11, style=filled, color="#555555", fontcolor="#111111", penwidth=1.2, margin="0.16,0.10"];
    edge [fontname="Bitter", fontsize=9, arrowsize=0.75, penwidth=1.5];

    // ========================================
    // NODES — corresponding to submitted diagram
    // ========================================
    CoreWeave [label="CoreWeave", shape=box, fillcolor="#E5E7EB"];
    CINECA [label="CINECA / EuroHPC", shape=box, fillcolor="#E5E7EB"];
    H100 [label="NVIDIA H100\nGPU infrastructure", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151"];
    Leonardo [label="Leonardo\nsupercomputer", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151"];
    Mistral [label="Mistral AI", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    OpenUsers [label="Model users /\ndeployers", shape=box, fillcolor="#D1FAE5"];
    SelfManaged [label="Self-managed deployment\n(Local / private / third-party cloud)", shape=cylinder, fillcolor="#D1FAE5"];
    Mistral7B [label="Mistral 7B\nApache 2.0", shape=box, fillcolor="#FEF3C7", style="rounded,filled"];

    // ========================================
    // RELATIONSHIPS — indexed by Google Sheet evidence register
    // Blue = service; orange = infrastructure; green dotted = capability.
    // Faded = inferred / historical; orange dashed = planned.
    // Capability does not imply observed customer deployment.
    // ========================================
    CoreWeave -> H100 [label="Provides", color="#B45309"];
    CINECA -> Leonardo [label="Operates", color="#B45309"];
    H100 -> Mistral [label="Contracted GPU capacity\n(2023)", color="#B45309"];
    Leonardo -> Mistral [label="Computing resources\nand assistance", color="#B45309"];
    Mistral -> Mistral7B [label="Develops and releases\nopen weights", color="#2563EB"];
    Mistral7B -> OpenUsers [label="Weights available for download\n(Apache 2.0)", color="#059669", style=dotted, penwidth=2];
    OpenUsers -> SelfManaged [label="Option to self-deploy", color="#059669", style=dotted, penwidth=2];

}
