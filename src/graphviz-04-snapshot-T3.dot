digraph Mistral_T3 {
    // ========================================
    // GRAPH SETTINGS — consistent with original DOT files
    // ========================================
    graph [label="T₃ — Mistral AI Infrastructure Ecosystem (October 2025)", labelloc=t, fontsize=19, fontname="Bitter", rankdir=TB, bgcolor="white", nodesep=0.55, ranksep=0.55, splines=polyline, pad=0.35, outputorder=edgesfirst, newrank=true];
    node [fontname="Bitter", fontsize=11, style=filled, color="#555555", fontcolor="#111111", penwidth=1.2, margin="0.16,0.10"];
    edge [fontname="Bitter", fontsize=9, arrowsize=0.75, penwidth=1.5];

    // ========================================
    // NODES — corresponding to submitted diagram
    // ========================================
    CoreWeave [label="CoreWeave", shape=box, fillcolor="#E5E7EB"];
    GB200 [label="NVIDIA GB200\nGPU infrastructure", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151"];
    Microsoft [label="Microsoft Azure", shape=box, fillcolor="#E5E7EB"];
    AzureCompute [label="Azure supercomputing\ninfrastructure", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151"];
    Mistral [label="Mistral AI", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    OpenUsers [label="Model users /\ndeployers", shape=box, fillcolor="#D1FAE5"];
    SelfManaged [label="Self-managed deployment\n(Local / private / third-party cloud)", shape=cylinder, fillcolor="#D1FAE5"];
    OpenModels [label="Open-weight models\nMistral 7B / Mixtral / NeMo\nand subsequent releases", shape=box, fillcolor="#FEF3C7", style="rounded,filled"];
    Proprietary [label="Proprietary models\nMistral Large family\nand other hosted models", shape=box, fillcolor="#FEF3C7", style="rounded,filled"];
    Platform [label="La Plateforme\nHosted API", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    Hosted [label="Mistral-managed\ninference infrastructure", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151"];
    APIUsers [label="La Plateforme\nAPI customers", shape=box, fillcolor="#D1FAE5"];
    Bedrock [label="Amazon Bedrock\nManaged inference", shape=box, fillcolor="#E5E7EB"];
    AzureAI [label="Microsoft Azure AI\nManaged inference", shape=box, fillcolor="#E5E7EB"];
    Vertex [label="Google Vertex AI\nManaged MaaS", shape=box, fillcolor="#E5E7EB"];
    CloudUsers [label="Hyperscaler\ncloud customers", shape=box, fillcolor="#D1FAE5"];
    Enix [label="Enix inference\nengineering and operations**", shape=box, fillcolor="#E5E7EB", color="#B7B7B7", fontcolor="#888888", fillcolor="#F1F1F1"];
    LeChat [label="Le Chat Enterprise\n(May 2025)", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    Code [label="Mistral Code\n(June 2025)", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    Studio [label="AI Studio\nPrivate beta (October 2025)", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    EnterpriseUsers [label="Enterprise\ncustomers", shape=box, fillcolor="#D1FAE5"];
    EnterpriseDeployment [label="Enterprise-controlled deployment\n(Private / hybrid / on-premises)", shape=cylinder, fillcolor="#D1FAE5"];
    ComputePlanned [label="Mistral Compute\nAnnounced June 2025\n(not yet verified operational)", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151", style="dashed,filled", color="#B45309", fontcolor="#B45309", fillcolor="#FFF7ED"];

    // ========================================
    // RELATIONSHIPS — indexed by Google Sheet evidence register
    // Blue = service; orange = infrastructure; green dotted = capability.
    // Faded = inferred / historical; orange dashed = planned.
    // Capability does not imply observed customer deployment.
    // ========================================
    CoreWeave -> GB200 [label="Provides", color="#B45309"];
    GB200 -> Mistral [label="Contracted GPU capacity", color="#B45309"];
    Microsoft -> AzureCompute [label="Provides", color="#B45309"];
    AzureCompute -> Mistral [label="Supercomputing access\n(February 2024)", color="#B45309"];
    Mistral -> ComputePlanned [label="Announces infrastructure initiative", color="#B45309", style=dashed];
    Mistral -> OpenModels [label="Develops and releases\nopen weights", color="#2563EB"];
    Mistral -> Proprietary [label="Develops and offers", color="#2563EB"];
    OpenModels -> OpenUsers [label="Downloadable weights", color="#059669", style=dotted, penwidth=2];
    OpenUsers -> SelfManaged [label="Option to self-deploy", color="#059669", style=dotted, penwidth=2];
    OpenModels -> Bedrock [label="Model availability", color="#2563EB"];
    Proprietary -> Bedrock [label="Managed model access", color="#2563EB"];
    Proprietary -> AzureAI [label="Managed model access", color="#2563EB"];
    Proprietary -> Vertex [label="Managed MaaS", color="#2563EB"];
    Bedrock -> CloudUsers [color="#2563EB"];
    AzureAI -> CloudUsers [color="#2563EB"];
    Vertex -> CloudUsers [color="#2563EB"];
    Mistral -> Platform [label="Operates hosted API", color="#2563EB"];
    Platform -> Hosted [label="Provides inference service", color="#2563EB"];
    Enix -> Hosted [label="Engineering / operations", color="#2563EB", color="#B9B9B9", fontcolor="#888888"];
    Hosted -> APIUsers [label="Hosted inference\nvia API", color="#2563EB"];
    Mistral -> LeChat [label="Offers enterprise assistant", color="#2563EB"];
    Mistral -> Code [label="Offers coding assistant", color="#2563EB"];
    Mistral -> Studio [label="Introduces operational tooling", color="#2563EB"];
    LeChat -> EnterpriseUsers [label="Enterprise AI access", color="#2563EB"];
    Code -> EnterpriseUsers [label="Enterprise coding tools", color="#2563EB"];
    Studio -> EnterpriseUsers [label="Platform tooling\n(private beta)", color="#2563EB"];
    EnterpriseUsers -> EnterpriseDeployment [label="Private / hybrid deployment options", color="#059669", style=dotted, penwidth=2];

}
