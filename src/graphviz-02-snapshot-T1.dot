digraph Mistral_T1 {
    // ========================================
    // GRAPH SETTINGS — consistent with original DOT files
    // ========================================
    graph [label="T₁ — Mistral AI Infrastructure Ecosystem (December 2023)", labelloc=t, fontsize=19, fontname="Bitter", rankdir=TB, bgcolor="white", nodesep=0.55, ranksep=0.55, splines=polyline, pad=0.35, outputorder=edgesfirst, newrank=true];
    node [fontname="Bitter", fontsize=11, style=filled, color="#555555", fontcolor="#111111", penwidth=1.2, margin="0.16,0.10"];
    edge [fontname="Bitter", fontsize=9, arrowsize=0.75, penwidth=1.5];

    // ========================================
    // NODES — corresponding to submitted diagram
    // ========================================
    CoreWeave [label="CoreWeave**", shape=box, fillcolor="#E5E7EB", color="#B7B7B7", fontcolor="#888888", fillcolor="#F1F1F1"];
    CINECA [label="CINECA / EuroHPC**", shape=box, fillcolor="#E5E7EB", color="#B7B7B7", fontcolor="#888888", fillcolor="#F1F1F1"];
    H100 [label="NVIDIA H100\nGPU infrastructure", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151", color="#B7B7B7", fontcolor="#888888", fillcolor="#F1F1F1"];
    Leonardo [label="Leonardo\nsupercomputer", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151", color="#B7B7B7", fontcolor="#888888", fillcolor="#F1F1F1"];
    Mistral [label="Mistral AI", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    OpenUsers [label="Model users /\ndeployers", shape=box, fillcolor="#D1FAE5"];
    SelfManaged [label="Self-managed deployment\n(Local / private / third-party cloud)", shape=cylinder, fillcolor="#D1FAE5"];
    Mistral7B [label="Mistral 7B\nApache 2.0", shape=box, fillcolor="#FEF3C7", style="rounded,filled"];
    Mixtral [label="Mixtral 8x7B\nApache 2.0", shape=box, fillcolor="#FEF3C7", style="rounded,filled"];
    Platform [label="La Plateforme\n(beta)", shape=box, fillcolor="#BFDBFE", color="#2563EB", penwidth=2];
    Hosted [label="Mistral-managed\ninference infrastructure", shape=cylinder, fillcolor="#515151", fontcolor="white", color="#515151"];
    APIUsers [label="API customers", shape=box, fillcolor="#D1FAE5"];
    Enix [label="Enix inference\nengineering and operations", shape=box, fillcolor="#E5E7EB"];
    AzureCloud [label="Microsoft Azure\nCloud Infrastructure**", shape=box, fillcolor="#E5E7EB", color="#B7B7B7", fontcolor="#888888", fillcolor="#F1F1F1"];
    GoogleCloud [label="Google Cloud\nCloud Infrastructure**", shape=box, fillcolor="#E5E7EB", color="#B7B7B7", fontcolor="#888888", fillcolor="#F1F1F1"];

    // ========================================
    // RELATIONSHIPS — indexed by Google Sheet evidence register
    // Blue = service; orange = infrastructure; green dotted = capability.
    // Faded = inferred / historical; orange dashed = planned.
    // Capability does not imply observed customer deployment.
    // ========================================
    CoreWeave -> H100 [label="Provides", color="#B45309", color="#B9B9B9", fontcolor="#888888"];
    CINECA -> Leonardo [label="Operates", color="#B45309", color="#B9B9B9", fontcolor="#888888"];
    H100 -> Mistral [label="Contracted GPU capacity (2023)", color="#B45309", color="#B9B9B9", fontcolor="#888888"];
    Leonardo -> Mistral [label="Computing resources and assistance", color="#B45309", color="#B9B9B9", fontcolor="#888888"];
    Mistral -> Mistral7B [label="Develops and releases", color="#2563EB"];
    Mistral -> Mixtral [label="Develops and releases", color="#2563EB"];
    Mistral7B -> OpenUsers [label="Downloadable weights", color="#059669", style=dotted, penwidth=2];
    Mixtral -> OpenUsers [label="Downloadable weights", color="#059669", style=dotted, penwidth=2];
    OpenUsers -> SelfManaged [label="Option to self-deploy", color="#059669", style=dotted, penwidth=2];
    Mistral -> Platform [label="Introduces hosted API", color="#2563EB"];
    Platform -> Hosted [label="Operates inference service", color="#2563EB"];
    Hosted -> APIUsers [label="Hosted model inference\nvia API", color="#2563EB"];
    Enix -> Hosted [label="Inference engineering\nand operations", color="#2563EB"];
    AzureCloud -> Hosted [label="Probable cloud infrastructure", color="#B45309", color="#B9B9B9", fontcolor="#888888"];
    GoogleCloud -> Hosted [label="Probable cloud infrastructure", color="#B45309", color="#B9B9B9", fontcolor="#888888"];
    // ** 50% opacity in the submitted figure: inferred / probable relationship.
}
